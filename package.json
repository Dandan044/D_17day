{
  "name": "seven-days",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "七日之前 / SEVEN DAYS BEFORE - 末世准备与生存文字经营 roguelite",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:content": "tsx scripts/lint-content.ts",
    "check:copy": "tsx scripts/check-ui-copy.ts",
    "audit:ids": "tsx scripts/audit-ids.ts",
    "dump-copy": "tsx scripts/dump-copy.ts",
    "sim": "tsx scripts/simulate.ts",
    "verify": "tsx scripts/verify.ts",
    "stress:channels": "tsx scripts/stress-channels.ts",
    "probe:channels": "tsx scripts/channel-probe.ts",
    "mk:save": "tsx scripts/mk-save.ts",
    "preview:body": "esbuild scripts/preview-bodymap.tsx --bundle --platform=node --format=cjs --jsx=automatic --loader:.css=empty --outfile=.preview/body/_bundle.cjs --log-level=warning && node .preview/body/_bundle.cjs && node scripts/shot-file.mjs .preview/body/body.html .preview/body/body.png 1200 1500"
  },
  "license": "ISC",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
